# BillSplitter Backend Environment Configuration
# For Render Web Service deployment:
# Configure these in Render Dashboard -> Backend Web Service -> Environment Variables

# Port (Render assigns this automatically; defaults to 5000 locally)
PORT=5000

# Allowed Frontend Origins for CORS (comma-separated if multiple, no trailing slash)
# Include your Render frontend URL and any local development origins
ALLOWED_ORIGINS=https://billsplitter-frontend-g4qp.onrender.com,http://localhost:5173,http://127.0.0.1:5173

# Optional: Custom SQLite database file location (e.g., if using a Render Persistent Disk mounted at /var/data)
# DATABASE_PATH=/var/data/billsplitter.db

# Optional: Custom directory for uploaded receipts
# UPLOAD_FOLDER=/var/data/uploads

# Optional: External n8n AI webhook endpoint URL
# N8N_WEBHOOK_URL=https://your-n8n-instance.app/webhook/...

# Flask debug mode (keep false in production)
FLASK_DEBUG=false
